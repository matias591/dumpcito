{
 "name": "Old Claude without notification_type: only 'permission' messages count",
 "steps": [
  {
   "t": 0,
   "tool": "claude",
   "payload": {
    "session_id": "s1",
    "hook_event_name": "UserPromptSubmit",
    "cwd": "/work/app",
    "prompt": "x"
   }
  },
  {
   "t": 2,
   "tool": "claude",
   "payload": {
    "session_id": "s1",
    "hook_event_name": "Notification",
    "cwd": "/work/app",
    "message": "Claude is waiting for your input"
   },
   "expectEvents": [],
   "expectState": {
    "claude__s1": "working"
   }
  },
  {
   "t": 3,
   "tool": "claude",
   "payload": {
    "session_id": "s1",
    "hook_event_name": "Notification",
    "cwd": "/work/app",
    "message": "Claude needs your permission to use Edit"
   },
   "expectEvents": [
    {
     "kind": "needsAttention",
     "tool": "claude",
     "session": "s1"
    }
   ],
   "expectState": {
    "claude__s1": "waiting"
   }
  }
 ]
}