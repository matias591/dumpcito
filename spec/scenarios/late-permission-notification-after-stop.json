{
 "name": "Notification permission_prompt arriving after Stop does not resurrect an alert",
 "steps": [
  {
   "t": 0,
   "tool": "claude",
   "payload": {
    "session_id": "s1",
    "hook_event_name": "UserPromptSubmit",
    "cwd": "/work/app",
    "prompt": "x"
   }
  },
  {
   "t": 30,
   "tool": "claude",
   "payload": {
    "session_id": "s1",
    "hook_event_name": "Stop",
    "cwd": "/work/app"
   },
   "expectEvents": [
    {
     "kind": "finished",
     "tool": "claude",
     "session": "s1"
    }
   ]
  },
  {
   "t": 31,
   "tool": "claude",
   "payload": {
    "session_id": "s1",
    "hook_event_name": "Notification",
    "cwd": "/work/app",
    "notification_type": "permission_prompt",
    "message": "m"
   },
   "expectEvents": [],
   "expectState": {
    "claude__s1": "done"
   }
  }
 ]
}