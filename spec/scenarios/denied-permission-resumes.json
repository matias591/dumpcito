{
 "name": "PermissionDenied returns to working",
 "steps": [
  {
   "t": 0,
   "tool": "claude",
   "payload": {
    "session_id": "s1",
    "hook_event_name": "UserPromptSubmit",
    "cwd": "/work/app",
    "prompt": "x"
   }
  },
  {
   "t": 3,
   "tool": "claude",
   "payload": {
    "session_id": "s1",
    "hook_event_name": "PermissionRequest",
    "cwd": "/work/app",
    "tool_name": "Bash"
   },
   "expectEvents": [
    {
     "kind": "needsAttention",
     "tool": "claude",
     "session": "s1"
    }
   ]
  },
  {
   "t": 10,
   "tool": "claude",
   "payload": {
    "session_id": "s1",
    "hook_event_name": "PermissionDenied",
    "cwd": "/work/app",
    "tool_name": "Bash"
   },
   "expectState": {
    "claude__s1": "working"
   }
  }
 ]
}